VEILED_BOT_TOKEN=
VEILED_API_URL=https://api.veiled.lol/api/v1
VEILED_GATEWAY_URL=
BOT_PREFIX=!
VEILED_BOT_OWNER_ID=cxvhyvwg3bn2pge6fk6axn3dy2
# Veiled gateway settings (intents are comma-separated names or a decimal bitfield).
# Default matches Veiled's server default. MESSAGE_CONTENT, MEMBERS and PRESENCE are opt-in.
VEILED_BOT_INTENTS=ROOMS,MESSAGES,REACTIONS,THREADS,INVITES,WEBHOOKS,POLLS,MODERATION,VOICE_STATES,SCHEDULED_EVENTS,INTERACTIONS,ROLES
# To run a sharded process set one shard index and the shared shard count on each process.
VEILED_BOT_SHARD_ID=0
VEILED_BOT_SHARD_COUNT=1
